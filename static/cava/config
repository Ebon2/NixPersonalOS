# ─────────────────────────────────────────────────────────────────
# CAVA — Matrix theme
# ─────────────────────────────────────────────────────────────────

[general]
mode = normal
framerate = 60
autosens = 1
sensitivity = 100
bars = 0                  # 0 = automático según el ancho
bar_width = 2
bar_spacing = 1
bar_height = 32
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pipewire
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average
reverse = 0
bar_delimiter = 0         # 0 = carácter de bloque sólido

[color]
gradient = 1
gradient_count = 5
gradient_color_1 = '#003310'   # verde muy oscuro — base
gradient_color_2 = '#007a1f'   # verde oscuro — dim
gradient_color_3 = '#00cc33'   # verde medio
gradient_color_4 = '#00ff41'   # verde Matrix puro
gradient_color_5 = '#39ff14'   # verde neón — picos

[smoothing]
integral = 77
monstercat = 1
waves = 0
noise_reduction = 77

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1