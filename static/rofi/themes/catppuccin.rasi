* {
    bg:                   #0d0f0d;
    bg-alt:               #0f1f0f;
    fg:                   #c8ffc8;
    
    red:                  #f38ba8;
    green:                #39ff14;
    yellow:               #f9e2af;
    blue:                 #00ff41;
    magenta:              #cba6f7;
    cyan:                 #00e676;
    
    background-color:     @bg;
    text-color:           @fg;
    font:                 "JetBrainsMono Nerd Font 11";
}

window {
    transparency:         "real";
    background-color:     rgba(13, 15, 13, 0.95);
    border-radius:        15px;
    border:               3px;
    border-color:         @blue;
    width:                700px;
    padding:              25px;
}

mainbox {
    border:               0;
    padding:              0;
}

inputbar {
    children:             [ prompt, entry ];
    background-color:     @bg-alt;
    border-radius:        10px;
    padding:              15px;
    margin:               0 0 20px 0;
}

prompt {
    background-color:     transparent;
    text-color:           @blue;
    padding:              0 15px 0 0;
}

entry {
    background-color:     transparent;
    placeholder:          "🔍 Buscar...";
    placeholder-color:    rgba(205, 214, 244, 0.5);
}

listview {
    columns:              1;
    lines:                7;
    spacing:              10px;
    cycle:                false;
    dynamic:              true;
    scrollbar:            false;
}

element {
    padding:              15px;
    border-radius:        10px;
    spacing:              10px;
}

element-icon {
    size:                 32px;
}

element-text {
    background-color:     inherit;
    text-color:           inherit;
    vertical-align:       0.5;
}

element.normal.normal {
    background-color:     transparent;
    text-color:           @fg;
}

element.selected.normal {
    background-color:     @blue;
    text-color:           @bg;
}

element.alternate.normal {
    background-color:     @bg-alt;
    text-color:           @fg;
}
