// Waybar — modules.jsonc
// Catppuccin Mocha • NixOS edition
{
  // -------------------------------------------------------
  // NixOS logo — launcher principal
  //  = NixOS icon (NerdFont)  |  ❄ = fallback unicode
  // Si tu fuente tiene Nerd Font icons, verás el logo NixOS.
  // Si no, verás una copo de nieve ❄.
  // -------------------------------------------------------
  "custom/nixos": {
    "format": "NixOS",
    "on-click": "rofi -show drun -replace -i -theme ~/.config/rofi/themes/catppuccin.rasi",
    "tooltip": false
  },

  // -------------------------------------------------------
  // Workspaces
  // -------------------------------------------------------
  "hyprland/workspaces": {
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{name}",
    "format-icons": {
      "urgent":  "!",
      "active":  "●",
      "default": "○"
    },
    "persistent-workspaces": {
      "*": 5
    }
  },

  // -------------------------------------------------------
  // Window title
  // -------------------------------------------------------
  "hyprland/window": {
    "separate-outputs": true,
    "max-length": 60
  },

  // -------------------------------------------------------
  // Keyboard layout
  // -------------------------------------------------------
  "hyprland/language": {
    "format": "⌨ {short}"
  },

  // -------------------------------------------------------
  // Updates (NixOS)
  // -------------------------------------------------------
  "custom/updates": {
    "format": "⟳  {}",
    "tooltip-format": "{}",
    "escape": true,
    "return-type": "json",
    "exec": "~/.config/scripts/updates.sh",
    "restart-interval": 60,
    "tooltip": true
  },

  // -------------------------------------------------------
  // Pulseaudio / PipeWire
  // -------------------------------------------------------
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon}   {volume}%",
    "format-muted": " ",
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", ""]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol"
  },

  // -------------------------------------------------------
  // Battery
  // -------------------------------------------------------
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-alt": "{icon}    {time}",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": [" ", " ", " ", " ", " "]
  },

  // -------------------------------------------------------
  // Hardware group con drawer
  // -------------------------------------------------------
  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "not-memory",
      "transition-left-to-right": false
    },
    "modules": ["custom/system", "disk", "cpu", "memory"]
  },

  "custom/system": {
    "format": "⬡",
    "tooltip": false
  },

  "cpu": {
    "interval": 3,
    "format": "CPU: {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU: {usage}% | {avg_frequency} GHz"
  },

  "memory": {
    "interval": 5,
    "format": "RAM: {percentage}%",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
  },

  "disk": {
    "interval": 30,
    "format": "DSK: {percentage_used}%",
    "tooltip": true,
    "tooltip-format": "{path}: {used} / {total}"
  },

  // -------------------------------------------------------
  // Cliphist
  // -------------------------------------------------------
  "custom/cliphist": {
    "format": "📋",
    "on-click": "~/.config/scripts/cliphist.sh",
    "on-click-right": "cliphist wipe",
    "tooltip-format": "Clipboard Manager\nClick derecho: limpiar"
  },

  // -------------------------------------------------------
  // Power menu
  // -------------------------------------------------------
  "custom/exit": {
    "format": "⏻",
    "on-click": "~/.config/wofi-power/power.sh",
    "tooltip": false
  },

  // -------------------------------------------------------
  // Clock con calendario
  // -------------------------------------------------------
  "clock": {
    "format": "{:%a-%d-%b  %H:%M}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode"
    }
  },

  // -------------------------------------------------------
  // Tray
  // -------------------------------------------------------
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  // -------------------------------------------------------
  // Network
  // -------------------------------------------------------
  "network": {
    "format": "{ifname}",
    "format-wifi": "  {essid} {signalStrength}%",
    "format-ethernet": "  {ifname}",
    "format-disconnected": "✗  Sin red",
    "tooltip-format-wifi": "󰤨  {ifname} @ {essid}\nIP: {ipaddr}\nSeñal: {signalStrength}%\nFrec: {frequency}MHz\n↑ {bandwidthUpBits}  ↓ {bandwidthDownBits}",
    "tooltip-format-ethernet": "󰈀  {ifname}\nIP: {ipaddr}\n↑ {bandwidthUpBits}  ↓ {bandwidthDownBits}",
    "tooltip-format-disconnected": "Sin conexión",
    "max-length": 50,
    "on-click": "~/.config/.settings/networkmanager.sh"
  },

  // -------------------------------------------------------
  // Lock indicator
  // -------------------------------------------------------
  //"custom/lock": {
  //  "exec": "~/.config/waybar/scripts/locks.sh",
  //  "interval": 1,
  //  "return-type": "plain",
  //  "tooltip": false
  //},

  // -------------------------------------------------------
  // User
  // -------------------------------------------------------
  "user": {
    "format": "  {user}",
    "interval": 60,
    "icon": false
  }
}
